<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_main_menu"
    android:padding="32dp">

    <ImageView
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:src="@drawable/logo_sichuan_mahjong"
        android:layout_marginBottom="48dp"
        android:contentDescription="四川麻将" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_stats_panel"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_current_score"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="积分: 0"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_total_games"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="局数: 0"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_win_rate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="胜率: 0%"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:gravity="center" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_start_game"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="开始游戏"
        android:textSize="20sp"
        android:layout_marginBottom="16dp"
        style="@style/MahjongButton" />

    <Button
        android:id="@+id/btn_score_history"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="积分记录"
        android:textSize="20sp"
        android:layout_marginBottom="16dp"
        style="@style/MahjongButton" />

    <Button
        android:id="@+id/btn_settings"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="游戏设置"
        android:textSize="20sp"
        android:layout_marginBottom="16dp"
        style="@style/MahjongButton" />

    <Button
        android:id="@+id/btn_exit"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="退出游戏"
        android:textSize="20sp"
        style="@style/MahjongButton" />

</LinearLayout>